+if host_system == 'amigaos'
+  # libnix links these, but no header the build sees declares them, or
+  # they cannot work here: fork, and fcntl() on a socket (fc_nonblock()
+  # then uses ioctl(FIONBIO), which libnix passes to bsdsocket.library)
+  foreach func : ['nanosleep', 'fork', 'vfork', 'fcntl']
+    priv_conf_data.set('HAVE_' + func.underscorify().to_upper(), false)
+  endforeach
+endif
+
