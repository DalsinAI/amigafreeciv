+
+/* SetEnv FREECIV_AUDIOSTATS to a file name (RAM:audio.txt): the mixer's
+ * buffers go there every five seconds, the number mixed against the number
+ * the device plays in that time and the gaps between them, and so does the
+ * time each sound or music took to load. Fewer buffers than expected, or a
+ * worst gap well past a buffer's time, means sound was late. The lab is
+ * muted; this is how its sound is checked. */
+static BPTR amiga_stats_fh = 0;
+static int amiga_freq = 1, amiga_channels = 1;
+static Uint64 amiga_last, amiga_prev, amiga_gap_sum, amiga_gap_max;
+static Uint32 amiga_bufs, amiga_gaps;
+
+static void amiga_stats_write(const char *line)
+{
+  if (amiga_stats_fh) {
+    Write(amiga_stats_fh, (APTR)line, strlen(line));
+  }
+}
+
+/* Mix_SetPostMix: called in SDL's audio thread after each buffer is mixed */
+static void amiga_stats_postmix(void *udata, Uint8 *stream, int len)
+{
+  Uint64 now = SDL_GetPerformanceCounter();
+  Uint64 pf = SDL_GetPerformanceFrequency();
+
+  (void)udata;
+  (void)stream;
+  amiga_bufs++;
+  if (amiga_prev != 0) {
+    Uint64 gap = now - amiga_prev;
+
+    amiga_gap_sum += gap;
+    amiga_gaps++;
+    if (gap > amiga_gap_max) {
+      amiga_gap_max = gap;
+    }
+  }
+  amiga_prev = now;
+  if (amiga_last == 0) {
+    amiga_last = now;
+    amiga_bufs = 0;
+  } else if (now - amiga_last >= 5 * pf) {
+    char line[200];
+    Uint32 frames = len / (2 * amiga_channels);   /* 16-bit samples */
+    Uint32 ms = (Uint32)((now - amiga_last) * 1000 / pf);
+    Uint32 expect = (Uint32)((Uint64)ms * amiga_freq / frames / 1000);
+    Uint32 buf_us = (Uint32)((Uint64)frames * 1000000 / amiga_freq);
+
+    SDL_snprintf(line, sizeof(line),
+                 "audio: %u buffers in %u ms (%u expected), "
+                 "gap mean %u us, worst %u us, buffer %u us\n",
+                 (unsigned)amiga_bufs, (unsigned)ms, (unsigned)expect,
+                 (unsigned)(amiga_gaps ? amiga_gap_sum * 1000000 / pf / amiga_gaps : 0),
+                 (unsigned)(amiga_gap_max * 1000000 / pf), (unsigned)buf_us);
+    amiga_stats_write(line);
+    amiga_bufs = 0;
+    amiga_gaps = 0;
+    amiga_gap_sum = amiga_gap_max = 0;
+    amiga_last = now;
+  }
+}
+
+static void amiga_stats_load(const char *what, const char *path,
+                             Uint64 start, bool ok)
+{
+  if (amiga_stats_fh) {
+    char line[300];
+    Uint64 took = SDL_GetPerformanceCounter() - start;
+
+    SDL_snprintf(line, sizeof(line), "load %s %s: %u ms%s\n", what, path,
+                 (unsigned)(took * 1000 / SDL_GetPerformanceFrequency()),
+                 ok ? "" : " FAILED");
+    amiga_stats_write(line);
+  }
+}
