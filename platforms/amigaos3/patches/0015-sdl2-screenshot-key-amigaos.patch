+#ifdef __amigaos__
+#include <stdio.h>
+#include <string.h>
+
+/**********************************************************************//**
+  AmigaOS 3.x: F10 writes the whole window to PROGDIR:User/shot-NNN.png
+  (SDL2_image), and the same file again in pieces of 40000 bytes
+  (shot-NNN.png.00, .01 ...; joined end to end they are the PNG, with
+  zeros after its end to fill the last piece), small enough to copy out
+  of a test lab one at a time. Upstream's own
+  screenshot key (Print) is compiled out, and an Amiga has no such key.
+**************************************************************************/
+void amiga_screenshot(void)
+{
+  static int shot_nr = 1;
+  char name[64];
+  FILE *in;
+
+  if (main_surface == NULL) {
+    return;
+  }
+  SDL_snprintf(name, sizeof(name), "PROGDIR:User/shot-%03d.png", shot_nr);
+  if (IMG_SavePNG(main_surface, name) != 0) {
+    log_error("Screenshot %s: %s", name, SDL_GetError());
+    return;
+  }
+  log_normal("Screenshot %s", name);
+  if ((in = fopen(name, "rb")) != NULL) {
+    static char buf[40000];
+    size_t got;
+    int part = 0;
+
+    while ((got = fread(buf, 1, sizeof(buf), in)) > 0) {
+      char pname[72];
+      FILE *out;
+
+      if (got < sizeof(buf)) {
+        memset(buf + got, 0, sizeof(buf) - got);
+        got = sizeof(buf);
+      }
+      SDL_snprintf(pname, sizeof(pname), "%s.%02d", name, part++);
+      if ((out = fopen(pname, "wb")) != NULL) {
+        fwrite(buf, 1, got, out);
+        fclose(out);
+      }
+    }
+    fclose(in);
+  }
+  shot_nr++;
+}
+#endif /* __amigaos__ */
+
