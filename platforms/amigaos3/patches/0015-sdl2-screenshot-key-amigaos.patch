+#ifdef __amigaos__
+/**********************************************************************//**
+  AmigaOS 3.x: F10 writes the whole window to PROGDIR:User/shot-NNN.png
+  (SDL2_image), and the same picture again as JPEG strips of 60 lines
+  (shot-NNN-1.jpg ...), each small enough to copy out of a test lab one
+  file at a time. Upstream's own screenshot key (Print) is compiled out,
+  and an Amiga has no such key.
+**************************************************************************/
+void amiga_screenshot(void)
+{
+  static int shot_nr = 1;
+  char name[64];
+  int y, part;
+
+  if (main_surface == NULL) {
+    return;
+  }
+  SDL_snprintf(name, sizeof(name), "PROGDIR:User/shot-%03d.png", shot_nr);
+  if (IMG_SavePNG(main_surface, name) != 0) {
+    log_error("Screenshot %s: %s", name, SDL_GetError());
+  } else {
+    log_normal("Screenshot %s", name);
+  }
+  for (y = 0, part = 1; y < main_surface->h; y += 60, part++) {
+    int h = main_surface->h - y < 60 ? main_surface->h - y : 60;
+    SDL_Surface *strip =
+      SDL_CreateRGBSurfaceFrom((Uint8 *)main_surface->pixels
+                               + y * main_surface->pitch,
+                               main_surface->w, h, 32, main_surface->pitch,
+                               main_surface->format->Rmask,
+                               main_surface->format->Gmask,
+                               main_surface->format->Bmask,
+                               main_surface->format->Amask);
+
+    if (strip != NULL) {
+      SDL_snprintf(name, sizeof(name), "PROGDIR:User/shot-%03d-%d.jpg",
+                   shot_nr, part);
+      IMG_SaveJPG(strip, name, 80);
+      SDL_FreeSurface(strip);
+    }
+  }
+  shot_nr++;
+}
+#endif /* __amigaos__ */
+
