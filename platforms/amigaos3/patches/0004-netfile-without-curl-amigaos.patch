+#ifdef __amigaos__
+/* AmigaOS 3.x builds have no libcurl: every transfer fails with a message,
+   so the metaserver list and announcements are simply unavailable. */
+
+/*******************************************************************//**
+  Report that this build cannot fetch from the net.
+***********************************************************************/
+static void netfile_unavailable(const char *URL, nf_errmsg cb, void *data)
+{
+  if (cb != nullptr) {
+    char buf[2048];
+
+    fc_snprintf(buf, sizeof(buf),
+                "This build cannot fetch %s: no HTTP support", URL);
+    cb(buf, data);
+  }
+}
+
+struct section_file *netfile_get_section_file(const char *URL,
+                                              nf_errmsg cb, void *data)
+{
+  netfile_unavailable(URL, cb, data);
+  return nullptr;
+}
+
+bool netfile_download_file(const char *URL, const char *filename,
+                           nf_errmsg cb, void *data)
+{
+  netfile_unavailable(URL, cb, data);
+  return FALSE;
+}
+
+struct netfile_post *netfile_start_post(void)
+{
+  return nullptr;
+}
+
+void netfile_add_form_str(struct netfile_post *post,
